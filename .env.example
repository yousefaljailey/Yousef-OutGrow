# All variables are SERVER-SIDE ONLY — set them in
# Vercel → Project → Settings → Environment Variables.
# None of these are ever exposed to the browser.

# Gemini API key for the AI strategy widget (api/strategy.ts).
# Without it the widget serves a clearly-labeled sample preview.
GEMINI_API_KEY=

# Optional model override (default: gemini-3-pro-preview).
GEMINI_MODEL=

# Lead delivery (api/lead.ts) — configure at least one channel.
# Email via Resend (resend.com):
RESEND_API_KEY=
LEAD_TO_EMAIL=info@outgrowagency.com
LEAD_FROM_EMAIL=

# And/or POST every lead as JSON to a webhook (n8n / Zapier / Make / CRM):
LEAD_WEBHOOK_URL=
